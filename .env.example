# Copy to .env for local development (never commit .env)

# Full site URL for sitemap and canonical links (e.g. https://www.example.com). On Vercel, https://$VERCEL_URL is used if unset.
# SITE_URL=

# Clerk — dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional override (usually inferred from publishable key):
# CLERK_FRONTEND_API=

# Your Clerk user ID (admin). Dashboard → Users → copy User ID
OWNER_CLERK_USER_ID=

# SMTP (contact form / project brief emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=
# SMTP_FROM=

# --- Production on Vercel (optional locally) ---
# Vercel → Storage → Marketplace → Upstash Redis → Connect to project.
# Persists contract assignment + signature dates (serverless has no writable disk).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — Storage → Blob → Connect. Required for contract PDF uploads in production.
BLOB_READ_WRITE_TOKEN=
